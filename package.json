{
  "name": "wasl-support-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n customer,support \"npm run dev -w @wasl/customer\" \"npm run dev -w @wasl/support\"",
    "build": "npm run typecheck && npm run build -w @wasl/customer && npm run build -w @wasl/support",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p apps/customer/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node --env-file=.env.live scripts/test-live.mjs",
    "preview": "node scripts/serve.mjs",
    "users:seed": "node --env-file=.env.seed scripts/seed-users.mjs",
    "config": "node scripts/configure.mjs",
    "verify": "npm run build && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "predev": "npm run config",
    "prebuild": "npm run config",
    "build:vercel": "npm run build && node scripts/prepare-vercel.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.9",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@playwright/test": "^1.51.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10"
  }
}
